# 线上地址参考。按需复制到 .env；部署覆盖也可放在未跟踪的 .env.local 中。
ZCODE_BASE_URL=https://zcode.z.ai
# ZAI_OAUTH_ORIGIN / ZAI_OAUTH_CLIENT_ID 已随 P3 C1 供应商 OAuth 删除；
# ZAI_BUSINESS_BASE_URL 已随 P3 C2 供应商套餐/计费面（官网购买 webview）删除；
# BIGMODEL_API_BASE_URL 已随 P3 C4 供应商 family/specs 删除（最后一个读取方
# coding-plan-api-key CLI 适配器同时移除）。
# 可选运行时覆盖远程资产基址根（默认 GitHub Releases 扁平布局；会自动追加 /v<当前版本> tag 目录）。
ZCODE_CDN_BASE_URL=

# 导入会话的来源回链 base，不改变 API；保留 /cn/share，不含分享码。
# 修改 API origin 时同步修改此值，或删除此项以自动跟随 API origin；不要赋空值。
ZCODE_CONVERSATION_SHARE_WEB_URL=https://zcode.z.ai/cn/share
# 远程资源镜像完整基址（嵌套布局：不带版本的根目录，或固定到当前版本的目录均可）；留空走默认 GitHub Releases。
ZCODE_REMOTE_ASSET_CDN_BASE_URL=

# 可选本地 Provider 配置文件路径；留空使用内置线上配置。
ZCODE_BUILTIN_PROVIDER_CONFIG_FILE=

# 内网或私有部署地址没有线上默认值，按需显式填写。
ZCODE_DEPS_BASE_URL=
INTRANET_MACHINE_HOST=
ZCODE_DIST_BASE_URL=
